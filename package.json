{
  "name": "ts-package-template",
  "version": "0.0.0-dev",
  "description": "",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/**"
  ],
  "scripts": {
    "build": "pkgroll",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src/ tests/",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "keywords": [],
  "author": {
    "name": "Matt Riley",
    "email": "matt@mattriley.me",
    "url": "https://mattriley.me"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@types/node": "24.12.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.0.0",
    "pkgroll": "2.27.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  }
}
